{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@water-business/shared-types": ["../../packages/shared-types/dist/index.d.ts"],
      "@water-business/calculations": ["../../packages/calculations/dist/index.d.ts"],
      "@water-business/validation": ["../../packages/validation/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
