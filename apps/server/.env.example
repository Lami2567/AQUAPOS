# Render Central Backend Server Environment Variables
NODE_ENV=production
PORT=3000

# Database Configuration (Neon Serverless PostgreSQL or local SQLite)
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://username:password@ep-cool-dbname-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
JWT_SECRET=your_ultra_secure_jwt_secret_key_2026

# Allowed Frontend Origins for CORS (e.g. your Vercel URL or * for all)
CORS_ORIGIN=https://your-aquapos-app.vercel.app,http://localhost:3000,http://localhost:1420,tauri://localhost
