{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@water-business/shared-types": ["../../packages/shared-types/dist/index.d.ts"],
      "@water-business/calculations": ["../../packages/calculations/dist/index.d.ts"],
      "@water-business/validation": ["../../packages/validation/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
